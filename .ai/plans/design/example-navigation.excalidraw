      "roundness": null,
      "seed": 522654,
      "version": 2,
      "versionNonce": 1130508279,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792261406433,
      "link": null,
      "locked": false,
      "text": "Decisions to make here:\n1. Menu label: \"All examples\" / \"More\" / icon only?\n2. Menu placement: right end of the strip (shown) or above the Demo heading?\n3. Searchable (Command) or plain grouped dropdown?\n4. Keep \"More Examples\" link to /docs/examples inside the menu footer?",
      "originalText": "Decisions to make here:\n1. Menu label: \"All examples\" / \"More\" / icon only?\n2. Menu placement: right end of the strip (shown) or above the Demo heading?\n3. Searchable (Command) or plain grouped dropdown?\n4. Keep \"More Examples\" link to /docs/examples inside the menu footer?",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
