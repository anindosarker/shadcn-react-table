    },
    {
      "id": "text-65",
      "type": "text",
      "x": 820,
      "y": 640,
      "width": 356.40000000000003,
      "height": 135,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 514735,
      "version": 2,
      "versionNonce": 1281546777,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792261406433,
      "link": null,
      "locked": false,
      "text": "Select \"Example: Minimal v\" instead of tabs\n  hides what the group contains.\n\nKeep MRT link tabs, scroll with arrows\n  11 items at 1440, 2 rows at 1100, unreadable at 700.\n\nSidebar only\n  works, but a guide that embeds a group has no\n  way to jump to that example page.",
      "originalText": "Select \"Example: Minimal v\" instead of tabs\n  hides what the group contains.\n\nKeep MRT link tabs, scroll with arrows\n  11 items at 1440, 2 rows at 1100, unreadable at 700.\n\nSidebar only\n  works, but a guide that embeds a group has no\n  way to jump to that example page.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "lineHeight": 1.25,
      "autoResize": true,
      "containerId": null,
      "index": "b02"
    },
    {
      "id": "text-66",
      "type": "text",
      "x": 0,
      "y": 950,
      "width": 543.4000000000001,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
