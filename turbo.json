{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "locales/**",
        "storybook/static/**"
      ]
    },
    "dev": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "lib:build": {
      "outputs": [
        "dist/**",
        "locales/**"
      ]
    },
    "lib:build-locales": {
      "outputs": [
        "locales/**"
      ]
    },
    "lib:build-lib": {
      "outputs": [
        "dist/**"
      ]
    },
    "lib:dev": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "outputs": [
        "storybook-static/**"
      ]
    },
    "storybook:dev": {
      "cache": false
    }
  }
}
