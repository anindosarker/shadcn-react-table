      "css": {
        "@keyframes st-linear-progress-indeterminate": {
          "0%": {
            "left": "-35%",
            "right": "100%"
          },
          "60%": {
            "left": "100%",
            "right": "-90%"
          },
          "100%": {
            "left": "100%",
            "right": "-90%"
          }
        },
        ".st-progress-indeterminate [data-slot='progress-indicator']": {
          "position": "absolute",
          "top": "0",
          "bottom": "0",
          "width": "auto",
          "transform": "none",
          "transition": "none",
          "animation": "st-linear-progress-indeterminate 2.1s cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite"
        },
        "@keyframes st-collapsible-right": {
