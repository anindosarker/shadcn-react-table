{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.radix.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@/*": ["./bases/radix/*", "./shared/*"]
    }
  },
  // The shared library is pulled in through its entry point and the locales,
  // every `@/` import resolving base-first, so a shared file that this base
  // overrides is never checked against this base's parts.
  "include": [
    "bases/radix",
    "shared/components/ui/shadcn-table/index.ts",
    "shared/components/ui/shadcn-table/locales"
  ],
  // Node-only item definition, read by registry/build.mjs.
  "exclude": ["bases/radix/registry.ts"]
}
