{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.base.tsbuildinfo",
    "customConditions": ["st-base"],
    "paths": {
      "@/components/ui/shadcn-table/*": ["./bases/radix/components/ui/shadcn-table/*"],
      "@/components/ui/*": ["./base/components/ui/*"],
      "@/*": ["./bases/radix/*"]
    }
  },
  "include": ["bases/radix"],
  "exclude": [
    "bases/radix/components/ui/*.tsx",
    "bases/radix/components/ui/shadcn-table/primitives/radix"
  ]
}
