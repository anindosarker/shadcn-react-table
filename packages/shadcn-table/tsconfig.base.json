{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.base.tsbuildinfo",
    "paths": {
      "@/*": ["./bases/base/*"]
    }
  },
  "include": ["bases/base"],
  // Node-only item definition, read by scripts/build-registry.mjs.
  "exclude": ["bases/base/registry.ts"]
}
