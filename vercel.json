{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs": {
      "root": "apps/shadcn-react-table-docs",
      "framework": "nextjs"
    },
    "storybook": {
      "root": "packages/shadcn-react-table",
      "framework": null,
      "buildCommand": "pnpm storybook:build",
      "outputDirectory": "storybook-static"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "storybook." } }],
      "destination": { "service": "storybook" }
    },
    { "source": "/(.*)", "destination": { "service": "docs" } }
  ]
}
